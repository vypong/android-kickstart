package {{PACKAGE}}.ui.home

import {{PACKAGE}}.MainDispatcherRule
import {{PACKAGE}}.data.repository.FakeAuthRepository
{{#if store}}
import {{PACKAGE}}.data.repository.FakeItemRepository
{{/if}}
import kotlinx.coroutines.ExperimentalCoroutinesApi
import kotlinx.coroutines.flow.first
import kotlinx.coroutines.test.runTest
import org.junit.Assert.assertEquals
import org.junit.Assert.assertNull
import org.junit.Rule
import org.junit.Test

/**
 * These tests wait for the state they care about rather than counting emissions or advancing
 * the scheduler by hand.
 *
 * uiState is a stateIn(WhileSubscribed) flow, so it stays at its initial value until someone
 * collects it. `first { ... }` both starts that subscription and suspends until the condition
 * holds, which makes the test independent of how many intermediate values combine() happens
 * to produce. Counting them is what made an earlier version of this file pass locally and
 * time out on CI.
 */
@OptIn(ExperimentalCoroutinesApi::class)
class HomeViewModelTest {

    @get:Rule
    val mainDispatcherRule = MainDispatcherRule()

    private val authRepository = FakeAuthRepository()
{{#if store}}
    private val itemRepository = FakeItemRepository()
    private val viewModel = HomeViewModel(authRepository, itemRepository)
{{else}}
    private val viewModel = HomeViewModel(authRepository)
{{/if}}

    @Test
    fun `starts loaded with no signed-in user`() = runTest(mainDispatcherRule.testDispatcher) {
        val state = viewModel.uiState.first { !it.isLoading }

        assertNull(state.user)
    }

    @Test
    fun `shows the signed-in user`() = runTest(mainDispatcherRule.testDispatcher) {
        authRepository.signIn("vee@example.com", "secret1")

        val state = viewModel.uiState.first { it.user != null }

        assertEquals("vee", state.user?.displayName)
        assertEquals("vee@example.com", state.user?.email)
    }

    @Test
    fun `signing out clears the user`() = runTest(mainDispatcherRule.testDispatcher) {
        authRepository.signIn("vee@example.com", "secret1")
        viewModel.uiState.first { it.user != null }

        viewModel.signOut()

        assertNull(viewModel.uiState.first { !it.isLoading && it.user == null }.user)
    }
{{#if store}}

    @Test
    fun `adding an item surfaces it in state`() = runTest(mainDispatcherRule.testDispatcher) {
        viewModel.addItem("Ship it")

        val state = viewModel.uiState.first { it.items.isNotEmpty() }

        assertEquals(listOf("Ship it"), state.items.map { it.label })
    }

    @Test
    fun `blank labels are ignored`() = runTest(mainDispatcherRule.testDispatcher) {
        // Adding a real item afterwards gives the test something to wait for. Waiting for
        // the blank one to be rejected would mean waiting for a state that never arrives.
        viewModel.addItem("   ")
        viewModel.addItem("kept")

        val state = viewModel.uiState.first { it.items.isNotEmpty() }

        assertEquals(listOf("kept"), state.items.map { it.label })
    }

    @Test
    fun `clearing removes every item`() = runTest(mainDispatcherRule.testDispatcher) {
        viewModel.addItem("one")
        viewModel.addItem("two")
        viewModel.uiState.first { it.items.size == 2 }

        viewModel.clearItems()

        assertEquals(emptyList<String>(), viewModel.uiState.first { it.items.isEmpty() }.items)
    }
{{/if}}
}
